{
  "manifest_version": 3,
  "name": "CVAT SAM 3 Segment",
  "version": "1.0.0",
  "description": "Click-to-segment on any CVAT instance using a self-hosted SAM 3 model (Nuclio/Docker).",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "scripting"],
  "host_permissions": [
    "https://cvat.edufun.ai/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "CVAT SAM 3 — settings",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["https://cvat.edufun.ai/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
