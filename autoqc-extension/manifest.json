{
  "manifest_version": 3,
  "name": "CVAT AutoQC",
  "version": "1.0.0",
  "description": "Simple machine QC panel for CVAT jobs.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "scripting"],
  "host_permissions": [
    "https://cvat.edufun.ai/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "CVAT AutoQC settings"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://cvat.edufun.ai/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
